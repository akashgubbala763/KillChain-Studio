# Backend Application Configuration
PROJECT_NAME="Intelligent Network Security Monitoring Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL default, with SQLite fallback)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/security_soc"
# For local SQLite fallback:
# DATABASE_URL="sqlite+aiosqlite:///./security_soc.db"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Simulator Settings
SIMULATOR_AUTOSTART=false
SIMULATOR_INTERVAL_SECONDS=2.0

# ML Artifact Paths
ML_MODEL_DIR="./ml/models"
